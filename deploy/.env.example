# ============================================================================
# Dokploy → Compose servisi → Environment alanına yapıştırın ve doldurun.
# ============================================================================

# Sitenin alan adı (https:// ve www OLMADAN). www.<alan adı> otomatik ana adrese yönlenir.
DOMAIN=ornek-alanadi.com

# Oturum imzalama anahtarı — EN AZ 32 karakter, rastgele. Değiştirilirse herkesin oturumu kapanır.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Yönetim paneli hesabı — ilk açılışta bu bilgilerle kurulur (sonraki açılışlarda dokunulmaz).
# Şifre en az 10 karakter, harf ve rakam içermeli.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Panel kullanıcıları (isteğe bağlı): alperen@, omer@ ve personel@nemiraturizm.com hesaplarının geçici
# şifreleri. Hesap yoksa açılışta oluşturulur; varsa dokunulmaz. Hesaplar açıldıktan sonra silinebilir.
# ALPEREN_PASSWORD=
# OMER_PASSWORD=
# PERSONEL_PASSWORD=

# İsteğe bağlı: veritabanı yedeklerinin kaç gün tutulacağı (varsayılan 14)
# BACKUP_KEEP_DAYS=14

# ── Yeni başvuru bildirimleri (isteğe bağlı) ────────────────────────────────
# E-posta: kurumsal e-postanızın SMTP bilgileri. Yeni başvuru NOTIFY_EMAIL'e gider;
# başvuruda e-posta yazan müşteriye otomatik "talebiniz alındı" e-postası gönderilir.
# SMTP_HOST=mail.alanadiniz.com
# SMTP_PORT=587
# SMTP_USER=info@alanadiniz.com
# SMTP_PASS=
# SMTP_FROM=info@alanadiniz.com
# NOTIFY_EMAIL=info@alanadiniz.com
# Telegram: @BotFather'dan bot oluşturup token ve sohbet kimliğini girin.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# WhatsApp: işletme numaranızın WhatsApp'ından +34 623 78 95 80 numarasına
# "I allow callmebot to send me messages" yazın; gelen anahtarı buraya girin.
# Numara boş bırakılırsa Site Ayarları'ndaki WhatsApp numarası kullanılır.
# CALLMEBOT_APIKEY=
# CALLMEBOT_PHONE=905015655844
