# ============================================================================
# Dokploy → Compose servisi → Environment alanına yapıştırın ve doldurun.
# ============================================================================

# Sitenin alan adı (https:// ve www OLMADAN). www.<alan adı> otomatik ana adrese yönlenir.
DOMAIN=ornek-alanadi.com

# Oturum imzalama anahtarı — EN AZ 32 karakter, rastgele. Değiştirilirse herkesin oturumu kapanır.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Yönetim paneli hesabı — ilk açılışta bu bilgilerle kurulur (sonraki açılışlarda dokunulmaz).
# Şifre en az 10 karakter, harf ve rakam içermeli.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# İsteğe bağlı: veritabanı yedeklerinin kaç gün tutulacağı (varsayılan 14)
# BACKUP_KEEP_DAYS=14
