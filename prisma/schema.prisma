// Nemira Turizm — veritabanı şeması
// Veritabanı: SQLite (yerel dosya)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  // Şifre değişince artırılır; eski oturumları geçersiz kılar
  tokenVersion      Int       @default(0)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  order       Int      @default(0)
  tours       Tour[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tour {
  id               String   @id @default(cuid())
  /// Müşteriye gösterilen tur numarası (boşsa otomatik verilir)
  code             String?  @unique
  /// Başlık üstündeki küçük etiket (ör. "Miraç Kandili Medine")
  badge            String?
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  categoryId       String
  category         TourCategory @relation(fields: [categoryId], references: [id])
  departureDate    DateTime?
  returnDate       DateTime?
  durationDays     Int?
  durationNights   Int?
  departureCity    String?
  airline          String?
  startingPrice    Float?
  currency         String   @default("USD")
  priceNote        String?
  coverImage       String?
  includedServices String?
  excludedServices String?
  requiredDocuments String?
  /// Kalan koltuk (boşsa gösterilmez)
  seatsLeft        Int?
  /// Tanıtım videosu (YouTube bağlantısı)
  videoUrl         String?
  isFeatured       Boolean  @default(false)
  isPublished      Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  images           TourImage[]
  prices           TourPrice[]
  hotels           TourHotel[]
  legs             TourLeg[]
  dayPrograms      TourDayProgram[]
  faqs             FAQ[]
  reviews          Review[]
  leads            Lead[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TourImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TourPrice {
  id        String   @id @default(cuid())
  roomType  String
  price     Float
  currency  String   @default("USD")
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Tur detayındaki otel kartları (Mekke, Medine…)
model TourHotel {
  id        String   @id @default(cuid())
  city      String
  name      String
  nights    Int?
  stars     Int?
  distance  String?
  image     String?
  videoUrl  String?
  link      String?
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Uçuş ve transfer bilgileri (Gidiş, otobüs transferi, Dönüş…)
model TourLeg {
  id        String    @id @default(cuid())
  /// "flight" | "bus"
  type      String    @default("flight")
  title     String
  carrier   String?
  flightNo  String?
  fromCode  String?
  fromCity  String?
  toCode    String?
  toCity    String?
  date      DateTime?
  time      String?
  order     Int       @default(0)
  tourId    String
  tour      Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

/// Ziyaretçi değerlendirmeleri (panelden onaylananlar yayınlanır)
model Review {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  title      String?
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([tourId, isApproved])
}

model TourDayProgram {
  id          String   @id @default(cuid())
  dayNumber   Int
  title       String
  description String
  /// Buluşma / hareket saati (ör. "07:30")
  time        String?
  /// Buluşma yeri (ör. "Otel lobisi")
  place       String?
  tourId      String
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  region      String?
  distance    String?
  stars       Int?
  description String?
  images      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?
  content        String
  coverImage     String?
  category       String?
  readTime       Int?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  personCount Int?
  tourTitle   String?
  message     String?
  status      String   @default("Yeni")
  source      String?
  note        String?
  tourId      String?
  tour        Tour?    @relation(fields: [tourId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentCertificate {
  id          String   @id @default(cuid())
  title       String
  image       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  tourId    String?
  tour      Tour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Ana sayfada slider altındaki Instagram hikayesi tarzı yuvarlak videolar / fotoğraflar
model Story {
  id          String      @id @default(cuid())
  title       String
  /// Yuvarlak kapak görseli (boşsa ilk içerik kullanılır)
  cover       String?
  buttonLabel String?
  buttonUrl   String?
  order       Int         @default(0)
  isPublished Boolean     @default(true)
  items       StoryItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Hikayenin sırayla oynayan video / fotoğrafları
model StoryItem {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  /// Fotoğrafın ekranda kalma süresi (sn); videolar kendi süresince oynar
  duration  Int?
  order     Int      @default(0)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Admin panelinden yüklenen görseller ve videolar
model Media {
  id           String   @id @default(cuid())
  url          String   @unique
  fileName     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime @default(now())
}

/// Sayfa içerikleri (JSON). Anahtarlar lib/content/registry.ts içinde tanımlıdır.
model ContentBlock {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// Kampanya ve duyuru aboneleri (sayfa altındaki kayıt kutusu)
model Subscriber {
  id        String   @id @default(cuid())
  /// Telefon (905551112233 biçiminde) veya küçük harfli e-posta
  contact   String   @unique
  /// phone | email
  type      String
  fullName  String?
  /// Kaydın yapıldığı sayfa
  source    String?
  createdAt DateTime @default(now())
}

/// Arama motorları için açılış sayfaları (ör. /sivas-umre, /umre-fiyatlari)
model LandingPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  /// Başlık altındaki kısa açıklama
  description    String?
  image          String?
  /// Sayfa metni (## başlık, - madde, **kalın**)
  content        String
  /// Listelenecek turların kategorileri (virgülle ayrılmış slug'lar; boşsa tümü)
  tourCategories String?
  /// Turları bu kelimelere göre süz (ör. "Sivas")
  tourSearch     String?
  /// Tur listesi başlığı
  toursTitle     String?
  /// Tur sıralaması: onerilen | tarih | fiyat-artan | fiyat-azalan
  toursSort      String?
  /// Sık sorulan sorular: [{ "question": "...", "answer": "..." }]
  faqs           String?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/* ------------------------------------------------------------------ */
/* Satış ve alacak takibi (yalnızca panelde kullanılır)                 */
/* Tutarlar tam sayıdır; "ödenen" ve "kalan" saklanmaz, tahsilatlardan    */
/* hesaplanır.                                                          */
/* ------------------------------------------------------------------ */

/// Tur görevlisi (rehber / kafile başkanı)
model Staff {
  id        Int           @id @default(autoincrement())
  fullName  String
  tc        String?
  phone     String
  note      String?
  tours1    ServiceTour[] @relation("Guide1")
  tours2    ServiceTour[] @relation("Guide2")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

/// Satışı yapılan tur hizmeti (sitedeki katalog turlarından bağımsızdır)
model ServiceTour {
  id            Int      @id @default(autoincrement())
  name          String
  /// Dönem (ör. "2026 Ramazan Umresi") — satış listesi bu alana göre süzülür
  period        String
  departureDate DateTime
  returnDate    DateTime
  /// Kişi başı ücretler: 2/3/4 kişilik oda (en az biri girilir)
  price2        Int?
  price3        Int?
  price4        Int?
  currency      String   @default("USD")
  accommodation String?
  guide1Id      Int
  guide1        Staff    @relation("Guide1", fields: [guide1Id], references: [id])
  guide2Id      Int?
  guide2        Staff?   @relation("Guide2", fields: [guide2Id], references: [id])
  days          Int
  note          String?
  /// Pasif turlar yeni satışta listelenmez
  isActive      Boolean  @default(true)
  sales         Sale[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([period])
}

model Customer {
  id        Int      @id @default(autoincrement())
  fullName  String
  tc        String   @unique
  phone     String
  note      String?
  sales     Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id          Int         @id @default(autoincrement())
  date        DateTime
  tourId      Int
  tour        ServiceTour @relation(fields: [tourId], references: [id])
  customerId  Int
  customer    Customer    @relation(fields: [customerId], references: [id])
  note        String?
  reference   String?
  /// Oda kişi sayısı (2-4) — seçilince turun o oda tipindeki fiyatı önerilir
  roomSize    Int?
  price       Int
  /// İptal edilen satışlar toplamlara ve bakiyeye girmez
  isCancelled Boolean     @default(false)
  /// Kaydı yapan kullanıcının adı (kullanıcı silinse de kalır; eski kayıtlarda boş)
  createdByName String?
  payments    Payment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tourId])
  @@index([customerId])
}

/// Tahsilat (satışa yapılan ödeme)
model Payment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      Sale     @relation(fields: [saleId], references: [id])
  date      DateTime
  amount    Int
  /// Nakit | Havale | Kredi Kartı
  method    String   @default("Nakit")
  note      String?
  /// Kaydı yapan kullanıcının adı (kullanıcı silinse de kalır; eski kayıtlarda boş)
  createdByName String?
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([date])
}

/// Panelde kimin ne zaman ne yaptığının kaydı (panelden değiştirilemez, silinemez)
model ActivityLog {
  id        Int      @id @default(autoincrement())
  /// Kullanıcı silinse de kayıt kalsın diye ilişki kurulmaz; ad ayrıca saklanır
  userId    String?
  userName  String
  /// İlgili kayıt: Sale, Customer, ServiceTour, Staff, User (site içeriği işlemlerinde boş)
  entity    String?
  entityId  String?
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}
