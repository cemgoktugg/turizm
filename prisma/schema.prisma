// Rotamız Huzura — Hac & Umre Turizm veritabanı şeması
// Veritabanı: SQLite (yerel dosya)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  // Şifre değişince artırılır; eski oturumları geçersiz kılar
  tokenVersion      Int       @default(0)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TourCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  order       Int      @default(0)
  tours       Tour[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tour {
  id               String   @id @default(cuid())
  /// Müşteriye gösterilen tur numarası (boşsa otomatik verilir)
  code             String?  @unique
  /// Başlık üstündeki küçük etiket (ör. "Miraç Kandili Medine")
  badge            String?
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  categoryId       String
  category         TourCategory @relation(fields: [categoryId], references: [id])
  departureDate    DateTime?
  returnDate       DateTime?
  durationDays     Int?
  durationNights   Int?
  departureCity    String?
  airline          String?
  startingPrice    Float?
  currency         String   @default("USD")
  priceNote        String?
  coverImage       String?
  includedServices String?
  excludedServices String?
  requiredDocuments String?
  /// Kalan koltuk (boşsa gösterilmez)
  seatsLeft        Int?
  /// Tanıtım videosu (YouTube bağlantısı)
  videoUrl         String?
  isFeatured       Boolean  @default(false)
  isPublished      Boolean  @default(true)
  seoTitle         String?
  seoDescription   String?
  images           TourImage[]
  prices           TourPrice[]
  hotels           TourHotel[]
  legs             TourLeg[]
  dayPrograms      TourDayProgram[]
  faqs             FAQ[]
  reviews          Review[]
  leads            Lead[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TourImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TourPrice {
  id        String   @id @default(cuid())
  roomType  String
  price     Float
  currency  String   @default("USD")
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Tur detayındaki otel kartları (Mekke, Medine…)
model TourHotel {
  id        String   @id @default(cuid())
  city      String
  name      String
  nights    Int?
  stars     Int?
  distance  String?
  image     String?
  videoUrl  String?
  link      String?
  order     Int      @default(0)
  tourId    String
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Uçuş ve transfer bilgileri (Gidiş, otobüs transferi, Dönüş…)
model TourLeg {
  id        String    @id @default(cuid())
  /// "flight" | "bus"
  type      String    @default("flight")
  title     String
  carrier   String?
  flightNo  String?
  fromCode  String?
  fromCity  String?
  toCode    String?
  toCity    String?
  date      DateTime?
  time      String?
  order     Int       @default(0)
  tourId    String
  tour      Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

/// Ziyaretçi değerlendirmeleri (panelden onaylananlar yayınlanır)
model Review {
  id         String   @id @default(cuid())
  fullName   String
  email      String
  title      String?
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  tourId     String
  tour       Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([tourId, isApproved])
}

model TourDayProgram {
  id          String   @id @default(cuid())
  dayNumber   Int
  title       String
  description String
  tourId      String
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  region      String?
  distance    String?
  stars       Int?
  description String?
  images      String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  excerpt        String?
  content        String
  coverImage     String?
  category       String?
  readTime       Int?
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  personCount Int?
  tourTitle   String?
  message     String?
  status      String   @default("Yeni")
  source      String?
  note        String?
  tourId      String?
  tour        Tour?    @relation(fields: [tourId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentCertificate {
  id          String   @id @default(cuid())
  title       String
  image       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  tourId    String?
  tour      Tour?    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Ana sayfada slider altındaki Instagram hikayesi tarzı yuvarlak videolar / fotoğraflar
model Story {
  id          String      @id @default(cuid())
  title       String
  /// Yuvarlak kapak görseli (boşsa ilk içerik kullanılır)
  cover       String?
  buttonLabel String?
  buttonUrl   String?
  order       Int         @default(0)
  isPublished Boolean     @default(true)
  items       StoryItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Hikayenin sırayla oynayan video / fotoğrafları
model StoryItem {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  /// Fotoğrafın ekranda kalma süresi (sn); videolar kendi süresince oynar
  duration  Int?
  order     Int      @default(0)
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Admin panelinden yüklenen görseller ve videolar
model Media {
  id           String   @id @default(cuid())
  url          String   @unique
  fileName     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime @default(now())
}

/// Sayfa içerikleri (JSON). Anahtarlar lib/content/registry.ts içinde tanımlıdır.
model ContentBlock {
  key       String   @id
  data      String
  updatedAt DateTime @updatedAt
}
